# Supabase project URL and publishable (anon) key. Both are safe to expose to browsers;
# Row Level Security and end-to-end encryption protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Random secret used to HMAC dedupe keys in the SMS webhook (server only).
# Generate with: openssl rand -base64 32
INGEST_DEDUPE_SECRET=
